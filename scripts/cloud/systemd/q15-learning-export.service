[Unit]
Description=Export Q15 learning snapshots to GitHub
Wants=network-online.target
After=network-online.target q15.service

[Service]
Type=simple
User=q15
Group=q15
WorkingDirectory=/opt/q15/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/q15/venv/bin/python /opt/q15/app/tools/cloud_launcher.py --config /etc/q15/q15.env --config /etc/q15/safety.env -- /opt/q15/venv/bin/python /opt/q15/app/tools/learning_export.py
Restart=always
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/q15/app /var/lib/q15 /var/backups/q15

[Install]
WantedBy=multi-user.target
