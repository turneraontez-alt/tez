# Install the real values at /etc/q15/q15.env with mode 0640. The Q15 cloud
# launcher uses the same KEY=value parsing rules as the Windows local runner.
# Never commit credentials or private keys.
PORT=8000
Q15_AUTOSTART_REFRESH=1
PYTHONUNBUFFERED=1

# These defaults are duplicated in safety.env so a copied local env cannot
# accidentally activate order execution during migration.
Q15_EXEC_DRY_RUN=true
Q15_EXEC_KILL=true
Q15_EXEC_YES_DRY_RUN=true
Q15_EXEC_YES_KILL=true
