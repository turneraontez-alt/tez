{
  "protocol_id": "q15-rti-spot-rest-top-book-reservoir-v1",
  "protocol_status": "FROZEN_BEFORE_FIRST_ELIGIBLE_REST_BOOK_EVIDENCE",
  "final_pre_evidence_amendment": "At zero eligible rows, adversarial lineage review replaced mutable spot_client symbol inheritance with hash-frozen provider, symbol, quote-currency, endpoint, and query-parameter identities; readiness also requires the declared database uniqueness constraint and rejects duplicate asset-stage identities.",
  "eligible_rows_before_final_lineage_amendment": 0,
