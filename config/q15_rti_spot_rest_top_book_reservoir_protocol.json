      "XRP": {"provider": "coinbase", "symbol": "XRP-USD", "quote_currency": "USD"}
    },
    "request_contract_by_provider": {
      "coinbase": {
        "method": "GET",
        "url_template": "https://api.exchange.coinbase.com/products/{symbol}/book",
        "query": {"level": "1"}
      },
      "okx": {
        "method": "GET",
        "url_template": "https://www.okx.com/api/v5/market/books",
        "query": {"instId": "{symbol}", "sz": "1"}
      }
    },
    "depth_scope": "OFFICIAL_TOP_OF_BOOK_LEVEL_1",
    "request_must_start_at_or_after_target": true,
    "maximum_request_start_offset_seconds": 2.0,
