  "prospective_boundary": {
    "strictly_after_close_time": 1785618900.0,
    "first_eligible_close_time": 1785619800.0,
    "historical_backfill_allowed": false,
    "pre_boundary_rows_receive_credit": false
  },
  "capture_contract": {
    "assets": ["BNB", "BTC", "DOGE", "ETH", "HYPE", "SOL", "XRP"],
    "stages": ["13M", "12M30S", "12M", "11M30S"],
    "source_identity_by_asset": {
      "BNB": {"provider": "okx", "symbol": "BNB-USDT", "quote_currency": "USDT"},
      "BTC": {"provider": "coinbase", "symbol": "BTC-USD", "quote_currency": "USD"},
      "DOGE": {"provider": "coinbase", "symbol": "DOGE-USD", "quote_currency": "USD"},
      "ETH": {"provider": "coinbase", "symbol": "ETH-USD", "quote_currency": "USD"},
      "HYPE": {"provider": "okx", "symbol": "HYPE-USDT", "quote_currency": "USDT"},
