    "local_request_and_receive_clock_is_freshness_authority": true,
    "exchange_book_timestamp_is_mutation_provenance_not_receipt_freshness": true,
    "positive_two_sided_uncrossed_book_required": true,
    "schema_version": "official-spot-rest-top-book-v1"
  },
  "storage_contract": {
    "database": "data/q15_rti_spot_rest_top_book_v1.sqlite3",
    "sqlite_journal_mode": "WAL",
    "unique_identity": ["ticker", "close_time", "stage"],
    "canonical_evidence_sha256_required": true,
    "existing_identity_never_overwritten": true,
    "outcome_columns_forbidden": true,
    "failed_requests_are_retained": true
  },
  "noninterference": {
    "submit_is_nonblocking": true,
