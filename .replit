modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true

[nix]
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc", "executor"]
channel = "stable-25_05"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "gce"
run = ["python3", "app.py"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GitHub Relay"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Learning Export"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3.11 app.py"
waitForPort = 8000

[[workflows.workflow]]
name = "GitHub Relay"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 tools/github_relay.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Learning Export"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 tools/learning_export.py"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
KALSHI_WS_ENABLED = "true"
Q15_SPOT_WS_ENABLED = "true"
# v9.5 is authoritative; the legacy v9.4 "unified" loop (~1.6s/cycle) is computed
# then fully discarded by v9.5. Disable it to cut cycle time. Trade-off: the
# /api/q15-v9-4/unified/* endpoints, q15_v9_4_unified_* snapshot keys, and the
# v9.4 15M learning ledger go dark (all superseded by v9.5). Re-enable with "true".
Q15_V94_UNIFIED_ENABLED = "false"
Q15_ALERT_LEVEL_10M = "all"
Q15_ALERT_LEVEL_7M = "all"
Q15_V95_PROFILE_FEATURES = "true"
# Read-only challenger SHADOW: runs beside the champion, records paired
# predictions, learns from its own settled results, and reports per-15-min
# accuracy (challenger vs current system). NOT primary — never drives live
# output (Q15_CHALLENGER_AS_PRIMARY stays false).
Q15_CHALLENGER_ENABLED = "true"
Q15_CHALLENGER_AS_PRIMARY = "false"
Q15_POLYMARKET_ENABLED = "true"
"Q15_ULTOIM_TELEGRAM_CHAT_ID " = "-1001234567890"
LEARNING_EXPORT_INTERVAL = "1200"
Q15_ULTOIM_V2_ENABLED = "true"
Q15_ULTOIM_V2_RECORD_XFLOW = "true"
Q15_ULTOIM_V2_DELIVER_TOP_N = "3"
Q15_ULTOIM_V2_DELIVER_BY_RR = "true"
Q15_ULTOIM_V2_SKIP_15M = "true"
# 12M EXPENSIVE-NO slice -> LIVE (owner-approved): deliver 12M only for ask>=65 (the cheap <65 zone
# is suppressed). Data: 12M ask>=65 = 90.9%/+17c/bet (n=11 THIN); same expensive-NO edge as 10M.
# Reversible: set false to revert 12M to research-only.
Q15_ULTOIM_V2_DELIVER_12M = "true"
Q15_EXEC_DRY_RUN = "false"
Q15_EXEC_ENABLED = "true"
# SIZING (owner-set): flat $150 (15000c) per pick on EVERY interval — the prior 10M=$100 lever is
# folded into this uniform base. Hard per-pick ceiling raised to $300 (30000c) so the conviction
# upsize can land. CONVICTION DOUBLING (Q15_EXEC_CONVICTION_SIZING, default on): in a window where
# 3+ assets co-trigger a NO at 10M, the LEAD pick stays $150 and the 2nd-or-later pick doubles to
# $300 ("first 150, extras double") — so a 2-pick conviction window commits up to $450. Leverage on
# thin (~3-day) data; NO daily circuit breaker is set, so per-trade size is the main risk control.
# Revert: FLAT_STAKE_CENTS=7500 (or 0 for % sizing) and/or CONVICTION_SIZING=false.
Q15_EXEC_FLAT_STAKE_CENTS = "15000"
Q15_EXEC_MAX_STAKE_PER_PICK_CENTS = "30000"
Q15_EXEC_CONVICTION_SIZING = "true"
# FILL RELIABILITY: limit at the ask + 1c (still clamped to the 50-85c band) so a fast tick-up
# doesn't leave the order resting unfilled. Costs at most 1c/contract; converts "missed/rested"
# into "filled" on a marketable NO buy. Owner-approved. 0 = pay exactly the ask. Set to 0 to revert.
Q15_EXEC_LIMIT_OFFSET_CENTS = "1"
# 2 PICKS PER WINDOW, CONDITIONAL (owner-approved). Take up to 2 picks per settlement window, but the
# 2nd pick must have ask>=60c (the proven expensive-NO band; sub-60 is the cheap-NO loss zone). Data:
# 2nd pick +8.9c/bet overall, +10.7c/bet at ask>=60 (n=41). Cap is 2 (3rd pick is -EV). NOTE: this
# ~doubles per-window variance (same-window picks co-settle ~79-89%; worst all-lost 2-pick 10M window
# = -$200); the per-window budget self-caps at ~$200 and the daily stop is OFF (owner's choice). Revert
# by setting MAX_PICKS back to 1.
Q15_EXEC_MAX_PICKS_PER_WINDOW = "2"
Q15_EXEC_SECOND_PICK_MIN_ASK = "60"
# 1ST-PICK ASK FLOOR (owner-approved, data-backed): EVERY pick (incl. the 1st/main pick) must have
# ask>=56c. The 2nd-pick floor (60c above) already covered 2nd picks; this closes the gap where the
# main pick could be a losing cheap-NO. Data (ultoim_v2 live, n=230 fired NO resolved): the loss is
# concentrated at ask<=51 (-356c combined); ask>=52 is a positive plateau (52->60 all ~+1600c, within
# noise). 56 sits in that plateau with margin against the thin 52-55 cells. Protects the $100 10M
# stake first (10M at ask<58 was -7c/pick, the one zone 10M loses). 0 = no floor. Reversible.
Q15_EXEC_MIN_ENTRY_ASK = "56"
# DAILY STOP OFF (owner-chosen): both limits 0 -> no daily loss circuit breaker, and the per-order
# balance read is skipped (less latency + the bot is decoupled from the shared account, so manual
# trades never pause it). REMAINING guards: $75/$100 per-pick cap, max-6-open, 1-pick/window, and
# the kill switch (Q15_EXEC_KILL=true). Re-enable: set Q15_EXEC_DAILY_LOSS_LIMIT_CENTS back to 10000.
Q15_EXEC_DAILY_LOSS_LIMIT_CENTS = "0"
Q15_EXEC_DAILY_LOSS_LIMIT_PCT = "0"
