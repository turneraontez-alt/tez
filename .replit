modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true

[nix]
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc", "executor"]
channel = "stable-25_05"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "gce"
run = ["python3", "tools/replit_supervisor.py"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GitHub Relay"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Learning Export"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3.11 app.py"
waitForPort = 8000

[[workflows.workflow]]
name = "GitHub Relay"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 tools/github_relay.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Learning Export"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 tools/learning_export.py"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
KALSHI_WS_ENABLED = "true"
Q15_SPOT_WS_ENABLED = "true"
# v9.5 is authoritative; the legacy v9.4 "unified" loop (~1.6s/cycle) is computed
# then fully discarded by v9.5. Disable it to cut cycle time. Trade-off: the
# /api/q15-v9-4/unified/* endpoints, q15_v9_4_unified_* snapshot keys, and the
# v9.4 15M learning ledger go dark (all superseded by v9.5). Re-enable with "true".
Q15_V94_UNIFIED_ENABLED = "false"
Q15_ALERT_LEVEL_10M = "all"
Q15_ALERT_LEVEL_7M = "all"
Q15_V95_PROFILE_FEATURES = "true"
# Read-only challenger SHADOW: runs beside the champion, records paired
# predictions, learns from its own settled results, and reports per-15-min
# accuracy (challenger vs current system). NOT primary — never drives live
# output (Q15_CHALLENGER_AS_PRIMARY stays false).
Q15_CHALLENGER_ENABLED = "true"
Q15_CHALLENGER_AS_PRIMARY = "false"
Q15_POLYMARKET_ENABLED = "true"
"Q15_ULTOIM_TELEGRAM_CHAT_ID " = "-1001234567890"
LEARNING_EXPORT_INTERVAL = "1200"
Q15_ULTOIM_V2_ENABLED = "true"
Q15_ULTOIM_V2_RECORD_XFLOW = "true"
Q15_ULTOIM_V2_DELIVER_TOP_N = "2"  # show top 2 10M choices per 15-min window
Q15_ULTOIM_V2_DELIVER_BY_RR = "true"
Q15_ULTOIM_V2_SKIP_15M = "true"
# HIGH VOLATILITY FLIP paper alerts: separate model/ledger from V2 10M entries,
# but delivered to the existing V2 Telegram channel unless Q15_HVF_TELEGRAM_CHAT_ID
# is set. Paper-only means no order path exists for these signals.
Q15_HVF_ENABLED = "true"
Q15_HVF_MODEL_VERSION = "high-vol-flip-v4-more-fire-strict"
Q15_HVF_TELEGRAM_ENABLED = "false"
Q15_HVF_ALERT_TELEGRAM_ENABLED = "false" # explicit opt-in required for HVF alert Telegram sends
Q15_HVF_ASSETS = "XRP,SOL,ETH,BNB" # DOGE/HYPE removed from live HVF/MFS alert universe
Q15_HVF_INTERVALS = "12M,9M"  # confirmed HVF: entry alerts stay on 12M/9M
Q15_HVF_PAPER_ONLY = "true"
Q15_HVF_MAX_ALERTS_PER_WINDOW = "2"
Q15_HVF_MORE_FIRE_STRICT_ENABLED = "true"
Q15_HVF_MORE_FIRE_STRICT_ASSETS = "BNB,ETH,SOL,XRP"
Q15_HVF_MORE_FIRE_STRICT_INTERVALS = "12M,10M,8M,7M"
Q15_HVF_MORE_FIRE_YES_ASK_LO = "55"
Q15_HVF_MORE_FIRE_YES_ASK_HI = "75"
Q15_HVF_MORE_FIRE_SPREAD_MAX = "3"
Q15_HVF_MORE_FIRE_MIN_CAL_YES = "0.60"
Q15_HVF_MORE_FIRE_MIN_MID_JUMP_CENTS = "4"
Q15_HVF_EARLY_ENABLED = "true"
Q15_HVF_EARLY_ENTRY_ENABLED = "false" # early flips are watch/research only, not entry alerts
Q15_HVF_EARLY_WATCH_ENABLED = "true"
Q15_HVF_EARLY_ASK_LO = "50"
Q15_HVF_EARLY_ASK_HI = "65"
Q15_HVF_EARLY_MID_LO = "45"
Q15_HVF_EARLY_MID_HI = "62"
Q15_HVF_EARLY_SPREAD_MAX = "6"
Q15_HVF_OWN_EARLY_ASSETS = "XRP,SOL,ETH,BNB"
Q15_HVF_HYPE_EARLY_ENABLED = "false"       # replay: early HYPE bullish was not reliable yet
Q15_HVF_BTC_EARLY_FOLLOW_ENABLED = "false" # replay: early BTC-lag follow was noisy/negative
# --- 10M selective book (owner-enabled, in-sample edge -- watch it).
# Show top 2 10M choices per 15-min window; both YES and NO are gated by BTC confirmation
# + inverse-edge. YES is PAPER-ONLY; the live NO executor is NO-only guarded.
# Each reversible via its Q15_* env var.
Q15_ULTOIM_V2_NO_ONLY = "false"
Q15_ULTOIM_V2_BTC_CONFIRM = "true"
Q15_ULTOIM_V2_BTC_CONFIRM_MARGIN_YES = "0.10"  # C5: asymmetric YES cutoff (BTC>=0.60)
Q15_ULTOIM_V2_REQUIRE_INVERSE_EDGE = "true"
Q15_ULTOIM_V2_SKIP_7M = "true"  # 10M-only book: no 7M delivery
Q15_ULTOIM_V2_10M_SELECTIVE = "true"
Q15_ULTOIM_V2_10M_SELECTIVE_TOP_N = "2"
Q15_ULTOIM_V2_10M_IGNORE_BTC_CONFIRM = "false"
Q15_ULTOIM_V2_10M_EXCLUDE_ASSETS = "HYPE"
Q15_ULTOIM_V2_10M_YES_MARKET_MIN = "0.70"
Q15_ULTOIM_V2_10M_EXPENSIVE_NO_ASK_HI = "85"
# 7M is skipped globally in the 10M-only book; this NO-only lever stays as a separate fallback.
Q15_ULTOIM_V2_SKIP_7M_NO = "false"
Q15_ULTOIM_V2_YES_NOTIFY = "true"  # paper YES Telegram notifications (hiconv + BTC-confirm); NEVER an order
Q15_ULTOIM_V2_EXIT_WATCH_SECONDS = "600"
# 12M EXPENSIVE-NO slice -> LIVE (owner-approved): deliver 12M only for ask>=65 (the cheap <65 zone
# is suppressed). Data: 12M ask>=65 = 90.9%/+17c/bet (n=11 THIN); same expensive-NO edge as 10M.
# Reversible: set false to revert 12M to research-only.
Q15_ULTOIM_V2_DELIVER_12M = "false"   # 10M-ONLY book: 12M no longer delivers (reverted)
Q15_EXEC_DRY_RUN = "true"
Q15_EXEC_ENABLED = "true"
# SIZING (owner-set): flat $150 (15000c) per pick on EVERY interval — the prior 10M=$100 lever is
# folded into this uniform base. Hard per-pick ceiling raised to $300 (30000c) so the conviction
# upsize can land. CONVICTION DOUBLING (Q15_EXEC_CONVICTION_SIZING, default on): in a window where
# 3+ assets co-trigger a NO at 10M, the LEAD pick stays $150 and the 2nd-or-later pick doubles to
# $300 ("first 150, extras double") — so a 2-pick conviction window commits up to $450. Leverage on
# thin (~3-day) data; NO daily circuit breaker is set, so per-trade size is the main risk control.
# Revert: FLAT_STAKE_CENTS=7500 (or 0 for % sizing) and/or CONVICTION_SIZING=false.
Q15_EXEC_FLAT_STAKE_CENTS = "15000"
Q15_EXEC_MAX_STAKE_PER_PICK_CENTS = "30000"
Q15_EXEC_CONVICTION_SIZING = "true"
# FILL RELIABILITY: limit at the ask + 1c (still clamped to the 50-85c band) so a fast tick-up
# doesn't leave the order resting unfilled. Costs at most 1c/contract; converts "missed/rested"
# into "filled" on a marketable NO buy. Owner-approved. 0 = pay exactly the ask. Set to 0 to revert.
Q15_EXEC_LIMIT_OFFSET_CENTS = "1"
# 2 PICKS PER WINDOW, CONDITIONAL (owner-approved). Take up to 2 picks per settlement window, but the
# 2nd pick must have ask>=60c (the proven expensive-NO band; sub-60 is the cheap-NO loss zone). Data:
# 2nd pick +8.9c/bet overall, +10.7c/bet at ask>=60 (n=41). Cap is 2 (3rd pick is -EV). NOTE: this
# ~doubles per-window variance (same-window picks co-settle ~79-89%; worst all-lost 2-pick 10M window
# = -$200); the per-window budget self-caps at ~$200 and the daily stop is OFF (owner's choice). Revert
# by setting MAX_PICKS back to 1.
Q15_EXEC_MAX_PICKS_PER_WINDOW = "2"
Q15_EXEC_SECOND_PICK_MIN_ASK = "60"
# BTC CROSS-ASSET GATE — owner LIVE (default ON in code; pinned here for visibility + kill switch).
# Suppresses an alt-NO entry when BTC is contemporaneously bullish (lean>=0.50) OR the complex is
# risk-on (prior-window breadth>=0.50) — the regime where alt-NO fails because the alts co-move up
# with BTC. EXEMPTS >=3-co-trigger 10M conviction windows (those run ~100% and are protected by the
# defensive exit). Backtest (in-sample ~2.6 days): lifted kept-book accuracy 78->90% and trimmed the
# BTC-up co-settling losers. ⚠️ in-sample/thin data — watch it across regimes. KILL SWITCH: set
# Q15_EXEC_BTC_GATE="false" to disable instantly. Thresholds: Q15_EXEC_BTC_GATE_LEAN / _BREADTH.
Q15_EXEC_BTC_GATE = "true"
# 1ST-PICK ASK FLOOR (owner-approved, data-backed): EVERY pick (incl. the 1st/main pick) must have
# ask>=59c. Closes the cheap-NO loss zone: on the fuller fired-NO sample the whole 55-58c band is
# net-negative (55c 17%/-230c, 57c 0%/-114c; 55-58 combined ~-282c over n=14) while 59c+ is the clean
# 84% / +1541c plateau. 59 keeps the 59c winners (n small, +41c) and the entire 60c+ plateau while
# cutting 55-58. The old 55 floor let the worst single cent (55c, -230c) straight through. Protects the
# 10M stake first (10M at ask<58 was -7c/pick). 0 = no floor. Reversible. (Raised 55->59 per owner.)
Q15_EXEC_MIN_ENTRY_ASK = "59"
# DAILY STOP OFF (owner-chosen): both limits 0 -> no daily loss circuit breaker, and the per-order
# balance read is skipped (less latency + the bot is decoupled from the shared account, so manual
# trades never pause it). REMAINING guards: $75/$100 per-pick cap, max-6-open, 1-pick/window, and
# the kill switch (Q15_EXEC_KILL=true). Re-enable: set Q15_EXEC_DAILY_LOSS_LIMIT_CENTS back to 10000.
Q15_EXEC_DAILY_LOSS_LIMIT_CENTS = "0"
Q15_EXEC_DAILY_LOSS_LIMIT_PCT = "0"
Q15_EXEC_YES_ENABLED = "true"
Q15_EXEC_YES_DRY_RUN = "true"
#   The rule's tunables (defaults shown; uncomment to change). Sizing/caps/band are baked in code.
# Q15_EXEC_YES_MIN_PYES = "0.55"
# Q15_EXEC_YES_MIN_BTC_LEAN = "0.55"
# Q15_EXEC_YES_EXCLUDE_ASSETS = "BNB"
# Q15_EXEC_YES_ALLOWED_INTERVALS = "10M"
# Q15_EXEC_YES_FLAT_STAKE_CENTS = "15000"
# Q15_EXEC_YES_MAX_PICKS_PER_WINDOW = "2"
