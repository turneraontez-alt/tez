modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true

[nix]
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]
channel = "stable-25_05"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "gce"
run = ["python3", "app.py"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GitHub Relay"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "GitHub Relay"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 tools/github_relay.py"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
KALSHI_WS_ENABLED = "false"
