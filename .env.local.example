# Local Windows environment for Kalshi/Q15.
# Copy this file to .env.local and fill the secrets. Do not commit .env.local.

# Required secrets
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY="<paste EC private key PEM here, using \n between lines>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GH_PUSH_TOKEN=

# Optional: keep empty to run without Postgres signal persistence.
DATABASE_URL=

# Local runtime
PORT=8000
Q15_LOCAL_LOG_DIR=work/local-run/logs
Q15_LOCAL_PID_DIR=work/local-run/pids
Q15_LOCAL_BACKUP_DIR=work/local-run/backups
Q15_LOCAL_PYTHON=

# Replit workflow equivalents
GITHUB_RELAY_REPO=turneraontez-alt/tez
GITHUB_RELAY_BRANCH=main
GITHUB_RELAY_INTERVAL=20
LEARNING_EXPORT_REPO=turneraontez-alt/tez
LEARNING_EXPORT_BRANCH=learning-snapshots
LEARNING_EXPORT_INTERVAL=1200
LEARNING_EXPORT_DATA_DIR=data

# Market data and app behavior
KALSHI_WS_ENABLED=true
Q15_SPOT_WS_ENABLED=true
Q15_SPOT_DEPTH_ENABLED=true
Q15_SPOT_DEPTH_DB=data/q15_spot_depth_v1.sqlite3
Q15_SPOT_DEPTH_ASSETS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE
Q15_SPOT_DEPTH_RECORD_SECONDS=5
Q15_SPOT_DEPTH_LEVELS=5
Q15_SPOT_DEPTH_WS_MAX_SIZE_BYTES=16777216
Q15_STRANGLE_SHADOW=true
Q15_STRANGLE_SHADOW_OPEN_MARKS=780,600,420
Q15_FEED_PATH_RECORDER=true
Q15_FEED_LADDER=true
Q15_FEED_MARKET_ACTIVITY=true
Q15_FEED_SETTLE_INDEX=true
Q15_FEED_LIQ=true
Q15_V94_UNIFIED_ENABLED=false
Q15_ALERT_LEVEL_10M=all
Q15_ALERT_LEVEL_7M=all
Q15_V95_PROFILE_FEATURES=true
Q15_CHALLENGER_ENABLED=true
Q15_CHALLENGER_AS_PRIMARY=false
Q15_POLYMARKET_ENABLED=true

# V2/HVF/v3 bot settings
Q15_ULTOIM_V2_ENABLED=true
Q15_ULTOIM_V2_TELEGRAM_ENABLED=false
Q15_ULTOIM_V2_RECORD_XFLOW=true
Q15_ULTOIM_V2_DELIVER_TOP_N=2
Q15_ULTOIM_V2_DELIVER_BY_RR=true
Q15_ULTOIM_V2_SKIP_15M=true
Q15_ULTOIM_V2_NO_ONLY=false
Q15_ULTOIM_V2_BTC_CONFIRM=true
Q15_ULTOIM_V2_BTC_CONFIRM_MARGIN_YES=0.10
Q15_ULTOIM_V2_REQUIRE_INVERSE_EDGE=true
Q15_ULTOIM_V2_SKIP_7M=true
Q15_ULTOIM_V2_10M_SELECTIVE=true
Q15_ULTOIM_V2_10M_SELECTIVE_TOP_N=2
Q15_ULTOIM_V2_10M_IGNORE_BTC_CONFIRM=false
Q15_ULTOIM_V2_10M_EXCLUDE_ASSETS=HYPE
Q15_ULTOIM_V2_10M_YES_MARKET_MIN=0.70
Q15_ULTOIM_V2_10M_EXPENSIVE_NO_ASK_HI=85
Q15_ULTOIM_V2_SKIP_7M_NO=false
Q15_ULTOIM_V2_YES_NOTIFY=false
Q15_ULTOIM_V2_EXIT_WATCH_SECONDS=600
Q15_ULTOIM_V2_DELIVER_12M=false
Q15_ULTOIM_V2_DELIVERY_QUALITY_GUARD=true

Q15_HVF_ENABLED=true
Q15_HVF_MODEL_VERSION=high-vol-flip-v4-more-fire-strict
Q15_HVF_TELEGRAM_ENABLED=true
Q15_HVF_ALERT_TELEGRAM_ENABLED=true
Q15_HVF_TELEGRAM_CHAT_ID=
Q15_HVF_ASSETS=XRP,SOL,ETH,BNB
Q15_HVF_INTERVALS=12M,9M
Q15_HVF_PAPER_ONLY=true
Q15_HVF_MAX_ALERTS_PER_WINDOW=2
Q15_HVF_MORE_FIRE_STRICT_ENABLED=true
Q15_HVF_MORE_FIRE_STRICT_ASSETS=BNB,ETH,SOL,XRP
Q15_HVF_MORE_FIRE_STRICT_INTERVALS=12M,10M,8M,7M
Q15_HVF_MORE_FIRE_YES_ASK_LO=55
Q15_HVF_MORE_FIRE_YES_ASK_HI=75
Q15_HVF_MORE_FIRE_SPREAD_MAX=3
Q15_HVF_MORE_FIRE_MIN_CAL_YES=0.60
Q15_HVF_MORE_FIRE_MIN_MID_JUMP_CENTS=4
Q15_HVF_EARLY_ENABLED=true
Q15_HVF_EARLY_ENTRY_ENABLED=false
Q15_HVF_EARLY_WATCH_ENABLED=true
Q15_HVF_EARLY_ASK_LO=50
Q15_HVF_EARLY_ASK_HI=65
Q15_HVF_EARLY_MID_LO=45
Q15_HVF_EARLY_MID_HI=62
Q15_HVF_EARLY_SPREAD_MAX=6
Q15_HVF_OWN_EARLY_ASSETS=XRP,SOL,ETH,BNB
Q15_HVF_HYPE_EARLY_ENABLED=false
Q15_HVF_BTC_EARLY_FOLLOW_ENABLED=false

Q15_STRATEGY_BOTS_ENABLED=true
Q15_STRATEGY_BOTS_DB=data/q15_strategy_bots_v3.sqlite3
Q15_V3_TELEGRAM_ENABLED=true
Q15_V3_TELEGRAM_CHAT_ID=
Q15_V3_DRIFT_OUTBOX_ENABLED=true
Q15_V3_DRIFT_OUTBOX_DB=data/q15_drift_telegram_outbox.sqlite3
Q15_V3_HYPE_ALLOW_DUPLICATE_WINDOW=false
Q15_V3_RESEARCH_TELEGRAM_ENABLED=false
Q15_V3_SUPPRESS_OWNED_SOURCE_NOTIFICATIONS=true
Q15_V3_HVF_DEPTH_FLOW_WRAPPER_ENABLED=true
Q15_V3_HVF_WRAPPER_RESEARCH_ON_MISSING=true
Q15_V3_HVF_DEPTH_FLOW_NOTIFICATIONS_ONLY=true
Q15_V3_DEPTH_FORMULA_RESEARCH_ENABLED=true
Q15_V3_DEPTH_FORMULA_TELEGRAM_ENABLED=true
Q15_V3_DEPTH_FORMULA_SPREAD_MAX_CENTS=10
Q15_V3_DEPTH_FORMULA_ENTRY_ASK_MAX_CENTS=55
Q15_V3_DEPTH_FORMULA_SELECTED_ASK_DEPTH_MAX=50
Q15_V3_DEPTH_FORMULA_BID_ASK_RATIO_MIN=0.25
Q15_V3_COINBASE_TOP12_REQUIRED_FOR_ACCEPT=true
Q15_V3_COINBASE_TOP12_CONTRA_REJECT_ENABLED=true
Q15_V3_COINBASE_TOP12_DEADBAND=0.01
Q15_V3_COINBASE_TOP60_DEADBAND=0.01
Q15_V3_COMBINED_CONTRA_REJECT_ENABLED=true
Q15_V3_COINBASE_TOP250_DEADBAND=0.05
Q15_V3_SPOT_NET_NOTIONAL_60S_CONTRA_MIN=500
Q15_V3_KALSHI_TAKER_YES_15S_CONTRA_MIN=250
Q15_V3_HVF_MOREFIRE_L2_ALIGNMENT_ENABLED=true
Q15_V3_HVF_OWN_STRONG_TOP12_RECOVERY_ENABLED=true
Q15_V3_HVF_OWN_STRONG_TOP12_RECOVERY_ENTRY_MAX=85
Q15_V3_KRAKEN_L3_DEADBAND=0.10
Q15_V3_KRAKEN_L3_HARD_VETO_ENABLED=false
Q15_V3_BTC_REGIME_ENABLED=true
Q15_V3_BTC_REGIME_TESTING_ENABLED=true
Q15_V3_BTC_REGIME_MAX_AGE_SECONDS=180
Q15_V3_DRIFT_13M=true
Q15_V3_DRIFT_13M_NOTIFY=false
Q15_V3_DRIFT_FLOW_SPREAD=true
Q15_V3_DRIFT_FLOW_SPREAD_NOTIFY=true
# Legacy/diagnostic only. Accepted Drift core is frozen at <=2c in code.
Q15_V3_DRIFT_FLOW_SPREAD_MAX_CENTS=2
Q15_V3_SPOT_DEPTH_ENRICHMENT_ENABLED=true
# These may tighten enrichment, but cannot relax the hard 15s core ceiling.
Q15_V3_DRIFT_SPOT_SNAPSHOT_MAX_AGE_SECONDS=15
Q15_V3_DRIFT_SPOT_BOOK_MAX_AGE_SECONDS=15
Q15_V3_DRIFT_SPOT_TRADE_MAX_AGE_SECONDS=15
# Immutable lineage/evidence sources. Q15_BUILD_SHA may be injected by CI;
# local source checkouts fall back to HEAD plus a dirty-tree fingerprint once at startup.
Q15_BUILD_SHA=
Q15_INTERVAL_RESEARCH_DB=data/q15_interval_research_v1.sqlite3
Q15_MARKETLEAD_ENABLED=true
Q15_MARKETLEAD_DB=data/q15_marketlead_v1.sqlite3
Q15_MARKETLEAD_PROXY_SOURCES=coinbase,kraken
Q15_MARKETLEAD_MIN_PROXY_SOURCES=2
Q15_MARKETLEAD_MIN_VENUE_SOURCES=2
Q15_MARKETLEAD_REQUIRE_LIVE_PROXY_SOURCES=true
Q15_MARKETLEAD_SOURCE_STALE_SECONDS=3
Q15_MARKETLEAD_TRANSPORT_STALE_SECONDS=10
Q15_MARKETLEAD_SOURCE_FUTURE_TOLERANCE_SECONDS=0.5
Q15_MARKETLEAD_MAX_SOURCE_SPREAD_BPS=50
Q15_MARKETLEAD_SYNC_TOLERANCE_SECONDS=2
Q15_MARKETLEAD_MAX_PROXY_DISPERSION_BPS=25
Q15_MARKETLEAD_PAPER_LIMIT_CENTS=69
Q15_V91_SQLITE_PATH=q15_v91_state.sqlite3
Q15_V95_LEDGER_DB=data/q15_v95_ledger_v1.sqlite3
Q15_DRIFT_EVIDENCE_INTERVAL_MAX_AGE_SECONDS=180
Q15_DRIFT_EVIDENCE_V91_BUCKET_SECONDS=12
Q15_DRIFT_EVIDENCE_V91_MIN_OBSERVATIONS=3
Q15_DRIFT_EVIDENCE_V91_MAX_AGE_SECONDS=60
Q15_DRIFT_EVIDENCE_V95_MAX_AGE_SECONDS=180
Q15_DRIFT_EVIDENCE_BTC_MAX_AGE_SECONDS=180
Q15_DRIFT_EVIDENCE_BREADTH_MAX_AGE_SECONDS=15
Q15_DRIFT_EVIDENCE_FLOW_BUCKET_MAX_LAG_SECONDS=15
Q15_DRIFT_EVIDENCE_FLOW_TRADE_MAX_AGE_SECONDS=15
# Asymmetric-volume, balanced-V95 and accuracy-V91 lanes are always silent,
# RESEARCH_ONLY cohorts with independent 30/60/150 reviews.
Q15_V3_DRIFT_ADDON=true
# 11M add-ons are always quarantined research-only.
Q15_V3_DRIFT_ADDON_NOTIFY=false
Q15_V3_DRIFT_LATEQUAL=true
# Compatibility only: late qualifiers stay research-only and cannot deliver.
Q15_V3_DRIFT_LATEQUAL_NOTIFY=false
Q15_V3_DRIFT_NO_MIRROR=true
Q15_V3_DRIFT_NO_MIRROR_NOTIFY=false
Q15_V3_DRIFT_NO_EXPANSION=true
Q15_V3_DRIFT_NO_EXPANSION_NOTIFY=false
Q15_V3_DRIFT_NO_EXPANSION_SPREAD_MAX_CENTS=2
Q15_INTERVAL_RESEARCH_CROSSING_MAX_SECONDS=90
Q15_INTERVAL_RESEARCH_CROSSING_MAX_OFFSET_SECONDS=45

# Executor safety. Local scripts also force these unless Start-Q15Local.ps1 uses -AllowLiveTrading.
Q15_EXEC_ENABLED=true
Q15_EXEC_DRY_RUN=true
Q15_EXEC_KILL=true
Q15_EXEC_YES_ENABLED=true
Q15_EXEC_YES_DRY_RUN=true
Q15_EXEC_YES_KILL=true
Q15_EXEC_FLAT_STAKE_CENTS=15000
Q15_EXEC_MAX_STAKE_PER_PICK_CENTS=30000
Q15_EXEC_CONVICTION_SIZING=true
Q15_EXEC_LIMIT_OFFSET_CENTS=1
Q15_EXEC_MAX_PICKS_PER_WINDOW=2
Q15_EXEC_SECOND_PICK_MIN_ASK=60
Q15_EXEC_BTC_GATE=true
Q15_EXEC_MIN_ENTRY_ASK=59
Q15_EXEC_DAILY_LOSS_LIMIT_CENTS=0
Q15_EXEC_DAILY_LOSS_LIMIT_PCT=0
